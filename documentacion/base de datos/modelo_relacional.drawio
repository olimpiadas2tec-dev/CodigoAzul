        <mxCell id="titulo" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;spacingLeft=4;" value="Modelo Entidad-Relacion - Sistema Codigo Azul (v2)" vertex="1">
