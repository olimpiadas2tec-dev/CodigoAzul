        <mxCell id="leyenda" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;rounded=1;fillColor=#f5f5f5;strokeColor=#cccccc;whiteSpace=wrap;html=1;" value="Notacion UML (estandar OMG)&#xa;Multiplicidades: 1 = obligatorio uno | 0..1 = opcional uno | 0..* = cero o muchos&#xa;PK = clave primaria (subrayado) | FK = clave foranea (subrayado) | UK = clave unica / unicidad (italica)" vertex="1">
